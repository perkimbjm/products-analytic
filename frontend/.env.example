# VITE_API_BASE_URL=https://products-analytic-production.up.railway.app

# Cache configuration for TanStack Query
# Controls how long data stays fresh before background refetch, and how long to keep unused data
# Format: 5m (minutes), 10m, 1h (hours), 30d (days)

# Stale time: data considered "fresh" for this duration.
# After stale time, a background refetch happens but UI shows cached data.
# Shorter = fresher data, more network traffic. Longer = fewer requests, slightly stale data.
# Default: 5 minutes
VITE_CACHE_STALE_TIME=5m

# Garbage collection time: how long to keep unused data in memory.
# After this time, data is removed from the cache if it hasn't been accessed.
# Longer values = better UX when navigating back (data instant), higher memory usage.
# Default: 10 minutes
VITE_CACHE_GC_TIME=10m

# Basemap tile cache TTL (informational — actual caching is via HTTP headers from CDN).
# Basemaps change rarely, so long TTL is safe.
# Default: 30 days
VITE_CACHE_BASEMAP_TTL=30d

# Backend API URL (production only).
# - Development: biarkan kosong/komentar. Vite proxy meneruskan /api/* ke localhost:3000.
# - Production: isi dengan ROOT backend (TANPA "/api" dan TANPA trailing slash),
#   karena kode otomatis menambahkan "/api". Nilai ini di-bake saat BUILD, jadi
#   harus tersedia ketika `npm run build` dijalankan.
#
# Cloudflare deploy:
#   - Build lokal lalu `wrangler deploy`: taruh nilai di .env.production.
#   - Cloudflare Workers Builds (repo terhubung): set VITE_API_BASE_URL sebagai
#     build environment variable di dashboard Cloudflare.

