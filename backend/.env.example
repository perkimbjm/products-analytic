# ─────────────────────────────────────────────────────────────────────────────
# Backend environment configuration — EXAMPLE / TEMPLATE
#
# Copy this file to `.env` lalu isi nilai yang sebenarnya:
#   cp .env.example .env
#
# JANGAN commit file `.env` (sudah di-ignore via .gitignore).
# Lihat README.md → "Environment Variables" untuk penjelasan tiap variabel.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                       # development | production
PORT=3000                                  # Dev port (default kode: 8080; Docker/production pakai 8080)
LOG_LEVEL=info                             # debug | info | warn | error

# CORS — origin frontend yang diizinkan (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./data/app.sqlite            # Lokasi file SQLite

# Import dataset eksternal (hanya dipakai saat `npm run import`, bukan runtime)
# Isi dengan URL dataset MAPID kamu. JANGAN taruh api_key asli di file contoh ini.
MAPID_DATASET_URL=https://geoserver.mapid.io/layers_new/get_layer?api_key=YOUR_API_KEY&layer_id=YOUR_LAYER_ID&project_id=YOUR_PROJECT_ID
MAPID_API_TOKEN=                           # Bearer token (opsional)
